# Generate a long random value; the MCP client and browser worker must share it.
SPORTS_PREDICTOR_WEB_INTELLIGENCE_TOKEN=replace-with-a-long-random-secret
SPORTS_PREDICTOR_WEB_INTELLIGENCE_URL=http://localhost:8787
# Comma-separated host allow-list. Keep this narrow.
SPORTS_PREDICTOR_ALLOWED_DOMAINS=fotmob.com,sofascore.com,fbref.com
SPORTS_PREDICTOR_STAGEHAND_ENABLED=false
# Example: openai/gpt-4.1-mini or anthropic/claude-sonnet-4-5
SPORTS_PREDICTOR_STAGEHAND_MODEL=
# Supply only the provider key needed by your selected Stagehand model.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
